#!/usr/bin/env nu

def main [] {
    let root = $env.FORGE_ROOT
    glob $"($root)/platforms/**/*.cpp" | each { |it|
        let bin = $"($it | path parse | get parent)/($it | path parse | get stem)"
        if ($bin | path exists) { rm $bin }
    }
    print "[cpp-forge] 🧹 Cleaned up binary files."
}
